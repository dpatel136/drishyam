<!DOCTYPE html>
<html>
<head>
    <title>Drishyam: The Conclusion!!</title>

    <style>
        body {
            background-color: black;
            text-align: center;
            color: white;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        h1 {
            font-size: 50px;
            margin-top: 40px;
            color: #ffcc00;
        }

        .movie-image {
            width: 500px;
            max-width: 90%;
            border-radius: 10px;
            margin-top: 30px;
        }

        h2 {
            margin-top: 50px;
            color: #ffcc00;
        }

        .stars {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin: 30px auto;
            max-width: 1000px;
        }

        .star-card {
            background-color: #1a1a1a;
            border-radius: 12px;
            padding: 15px;
            width: 220px;
            box-shadow: 0 0 15px #444;
        }

        .star-card img {
            width: 200px;
            height: 260px;
            object-fit: cover;
            border-radius: 10px;
        }

        .star-card h3 {
            color: white;
            margin-top: 15px;
        }
    </style>
</head>

<body>

    <h1>Drishyam: The Conclusion</h1>

    <!-- Main Movie Image -->
    <img
        class="movie-image"
        src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Drishyam_star_cast_Ajay_Devgn%2C_Shriya_Saran_and_Tabu_with_suresh_sharma.jpg/720px-Drishyam_star_cast_Ajay_Devgn%2C_Shriya_Saran_and_Tabu_with_suresh_sharma.jpg"
        alt="Drishyam Movie"
    >

    <h2>⭐ Star Cast ⭐</h2>

    <div class="stars">

        <!-- Ajay Devgn -->
        <div class="star-card">
            <img
                src="https://upload.wikimedia.org/wikipedia/commons/6/6e/Ajay_Devgn_at_the_trailer_launch_of_%27Drishyam%27.jpg"
                alt="Ajay Devgn"
            >
            <h3>Ajay Devgn</h3>
        </div>

        <!-- Shriya Saran -->
        <div class="star-card">
            <img
                src="https://upload.wikimedia.org/wikipedia/commons/6/6c/Shriya_Saran_at_the_screening_of_Tadap.jpg"
                alt="Shriya Saran"
            >
            <h3>Shriya Saran</h3>
        </div>

        <!-- Tabu -->
        <div class="star-card">
            <img
                src="https://upload.wikimedia.org/wikipedia/commons/8/8e/Tabu_at_the_screening_of_Missing.jpg"
                alt="Tabu"
            >
            <h3>Tabu</h3>
        </div>

    </div>

</body>
</html>

