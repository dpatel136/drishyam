<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Drishyam: The Conclusion</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: #000;
            color: white;
            font-family: Arial, Helvetica, sans-serif;
            text-align: center;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
            padding: 30px 0 50px;
        }

        h1 {
            font-size: 50px;
            color: #ffcc00;
            margin: 20px 0 10px;
            text-shadow: 0 0 15px #ffcc00;
        }

        .subtitle {
            color: #ccc;
            font-size: 20px;
            margin-bottom: 30px;
        }

        .main-photo {
            width: 720px;
            max-width: 100%;
            border-radius: 15px;
            border: 3px solid #ffcc00;
            box-shadow: 0 0 30px rgba(255, 204, 0, 0.5);
        }

        h2 {
            color: #ffcc00;
            font-size: 32px;
            margin-top: 50px;
        }

        .cast-container {
            display: flex;
            justify-content: center;
            align-items: stretch;
            gap: 25px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .cast-card {
            background: #151515;
            width: 280px;
            padding: 20px;
            border-radius: 15px;
            border: 1px solid #333;
            box-shadow: 0 0 15px rgba(255,255,255,0.15);
        }

        .cast-card h3 {
            color: #ffcc00;
            font-size: 24px;
            margin-bottom: 5px;
        }

        .cast-card p {
            color: #aaa;
            font-size: 16px;
        }

        .story {
            margin: 50px auto 0;
            max-width: 800px;
            background: #111;
            padding: 25px;
            border-radius: 15px;
            border-left: 5px solid #ffcc00;
        }

        .story h2 {
            margin-top: 0;
        }

        .story p {
            color: #ddd;
            font-size: 18px;
            line-height: 1.7;
        }

        .footer {
            margin-top: 50px;
            padding: 20px;
            background: #111;
            color: #777;
            font-size: 14px;
        }

        @media (max-width: 600px) {

            h1 {
                font-size: 34px;
            }

            .subtitle {
                font-size: 16px;
            }

            h2 {
                font-size: 26px;
            }

            .cast-card {
                width: 90%;
            }

        }

    </style>

</head>


<body>

    <div class="container">

        <!-- Movie Title -->

        <h1>
            Drishyam: The Conclusion
        </h1>

        <div class="subtitle">
            ⭐ A Story of Family, Mystery &amp; Suspense ⭐
        </div>


        <!-- REAL DRISHYAM CAST PHOTOGRAPH -->

        <img
            class="main-photo"
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Drishyam_star_cast_Ajay_Devgn%2C_Shriya_Saran_and_Tabu_with_suresh_sharma.jpg/720px-Drishyam_star_cast_Ajay_Devgn%2C_Shriya_Saran_and_Tabu_with_suresh_sharma.jpg"
            alt="Ajay Devgn, Shriya Saran and Tabu from Drishyam"
        >


        <!-- STAR CAST -->

        <h2>
            ⭐ Star Cast ⭐
        </h2>


        <div class="cast-container">


            <!-- Ajay Devgn -->

            <div class="cast-card">

                <h3>
                    Ajay Devgn
                </h3>

                <p>
                    Vijay Salgaonkar
                </p>

            </div>


            <!-- Shriya Saran -->

            <div class="cast-card">

                <h3>
                    Shriya Saran
                </h3>

                <p>
                    Nandini Salgaonkar
                </p>

            </div>


            <!-- Tabu -->

            <div class="cast-card">

                <h3>
                    Tabu
                </h3>

                <p>
                    Meera Deshmukh
                </p>

            </div>

        </div>


        <!-- MOVIE INFORMATION -->

        <div class="story">

            <h2>
                About Drishyam
            </h2>

            <p>
                Drishyam is a mystery thriller centered around
                Vijay Salgaonkar and his family.
                The story combines suspense, family drama
                and an unexpected chain of events.
            </p>

        </div>

    </div>


    <!-- FOOTER -->

    <div class="footer">

        Drishyam Fan Page &nbsp; | &nbsp;
        Real Cast Photograph from Wikimedia Commons

    </div>

</body>

</html>

